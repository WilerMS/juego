    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "serve": "^14.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0"
